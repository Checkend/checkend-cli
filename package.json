{
	"name": "@checkend/cli",
	"version": "0.1.0",
	"description": "The command-line interface for Checkend, open-source error tracking for coding agents.",
	"license": "MIT",
	"author": "Furvur",
	"type": "module",
	"bin": {
		"ce": "dist/bin.js",
		"checkend": "dist/bin.js"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc -p tsconfig.json",
		"check": "npm run lint && npm run typecheck && npm test && npm run build",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
