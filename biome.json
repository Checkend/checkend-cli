{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!node_modules", "!dist"]
	},
	"formatter": {
		"lineWidth": 100
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useImportExtensions": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/sanitize.ts", "test/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noControlCharactersInRegex": "off"
					}
				}
			}
		}
	]
}
